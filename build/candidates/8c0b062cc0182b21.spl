| tstats summariesonly=false allow_old_summaries=false count min(_time) as firstTime max(_time) as lastTime FROM datamodel=Linux_Auditd.Auditd WHERE (index=linux) AND (Auditd.execve_command IN ("*find*", "*grep*") AND Auditd.execve_command IN ("*password*", "*pass *", "*credential*", "*creds*")) BY Auditd.argc Auditd.execve_command Auditd.host
| rename Auditd.argc AS argc Auditd.execve_command AS execve_command Auditd.host AS dest
| `security_content_ctime(firstTime)`
| `security_content_ctime(lastTime)`
| `linux_auditd_find_credentials_from_password_stores_filter`
