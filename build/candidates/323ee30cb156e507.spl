| tstats summariesonly=false allow_old_summaries=false count min(_time) as firstTime max(_time) as lastTime FROM datamodel=Linux_Auditd.Auditd WHERE (index=linux) AND (Auditd.type=SERVICE_STOP Auditd.unit IN ("firewalld", "ufw")) BY Auditd.type Auditd.pid Auditd.comm Auditd.exe Auditd.unit Auditd.host
| rename Auditd.type AS type Auditd.pid AS pid Auditd.comm AS comm Auditd.exe AS exe Auditd.unit AS unit Auditd.host AS dest
| `security_content_ctime(firstTime)`
| `security_content_ctime(lastTime)`
| `linux_auditd_disable_or_modify_system_firewall_filter`
