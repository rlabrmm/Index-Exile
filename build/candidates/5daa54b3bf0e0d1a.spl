| tstats summariesonly=false allow_old_summaries=false count min(_time) as firstTime max(_time) as lastTime FROM datamodel=Linux_Auditd.Auditd WHERE (index=linux) AND (Auditd.type=SERVICE_STOP) BY Auditd.type Auditd.pid Auditd.comm Auditd.exe Auditd.host
| rename Auditd.type AS type Auditd.pid AS pid Auditd.comm AS comm Auditd.exe AS exe Auditd.host AS dest
| `security_content_ctime(firstTime)`
| `security_content_ctime(lastTime)`
| `linux_auditd_stop_services_filter`
