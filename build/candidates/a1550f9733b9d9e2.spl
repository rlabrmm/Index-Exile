| tstats summariesonly=false allow_old_summaries=false count min(_time) as firstTime max(_time) as lastTime FROM datamodel=Linux_Auditd.Auditd WHERE (index=linux) AND (Auditd.execve_command = "*base64*" AND Auditd.execve_command IN ("*-d*", "* --d*")) BY Auditd.argc Auditd.execve_command Auditd.host
| rename Auditd.argc AS argc Auditd.execve_command AS execve_command Auditd.host AS dest
| `security_content_ctime(firstTime)`
| `security_content_ctime(lastTime)`
| `linux_auditd_base64_decode_files_filter`
