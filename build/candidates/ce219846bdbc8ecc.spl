| tstats summariesonly=false allow_old_summaries=false count min(_time) as firstTime max(_time) as lastTime FROM datamodel=Linux_Auditd.Auditd WHERE (index=linux) AND (Auditd.proctitle = "*chown *root*") BY Auditd.proctitle Auditd.host
| rename Auditd.proctitle AS proctitle Auditd.host AS dest
| `security_content_ctime(firstTime)`
| `security_content_ctime(lastTime)`
| `linux_auditd_change_file_owner_to_root_filter`
